# MentorHub Environment Variables Template
SECRET_KEY=django-insecure-mentor-hub-secret-key-change-in-production-2024
JWT_SECRET_KEY=jwt-secret-mentor-hub-auth-key-2024-secure-token
DEBUG=True

# Razorpay Test Mode API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret

# Agora Credentials (Optional)
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE
